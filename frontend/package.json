    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
