  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:preview": "vite build && electron .",
    "electron:build": "vite build && npx @electron/packager . \"Licence Pro Madagascar\" --platform=win32 --arch=x64 --out=dist-app --overwrite --prune=false",
    "build:electron": "npm run electron:build"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
